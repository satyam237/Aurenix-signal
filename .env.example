# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- Required for API testing (bulk_prompt_test.py, test_api_keys.py) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Required for Supabase pipeline + dashboard ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Models (defaults match shared/config.py) ---
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-2.5-flash

# --- Runtime limits ---
DAILY_COST_CAP_USD=10
CRON_HOUR_UTC=6
DEDUP_HOURS=6
BRAND_ID=nautikal
