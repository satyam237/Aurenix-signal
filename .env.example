# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- Required for API testing (bulk_prompt_test.py, test_api_keys.py) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Required for Supabase pipeline + dashboard ---
SUPABASE_URL=
# Secret key only — NOT the publishable key (sb_publishable_...). Use sb_secret_... or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Optional — for scripts/apply_schema.py --apply (Dashboard → Settings → Database)
SUPABASE_DB_PASSWORD=

# --- Models (defaults match shared/config.py) ---
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-3-flash-preview

# --- Runtime limits ---
DAILY_COST_CAP_USD=10
CRON_HOUR_UTC=6
DEDUP_HOURS=6
BRAND_ID=nautikal
BULK_CONCURRENCY=6
